{
  // 3D Cards on Cloudflare Workers.
  // The Worker name must match the project name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3d-cards",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // These paths go through src/worker.js first; everything else is served as a static file.
    "run_worker_first": ["/", "/index.html", "/s/*", "/api/*"]
  },
  // Storage for shared cards. Cloudflare creates it automatically on the first deploy
  // and reuses it on later deploys (matched by the binding name).
  "kv_namespaces": [{ "binding": "SHARES" }],
  // Public gallery: users, cards and votes. Created automatically on the first deploy, like SHARES.
  "d1_databases": [{ "binding": "DB" }],
  // Public ID of the Google "Web application" client (same as googleClientId in public/js/config.js).
  // Its secret is set in Cloudflare as the secret GOOGLE_WEB_CLIENT_SECRET.
  // Keep variables added in the Cloudflare dashboard (they are not in this file).
  "keep_vars": true,
  "vars": {
    "GOOGLE_WEB_CLIENT_ID": "210055593962-3ajro5cogq75030114aqmh737itftgcl.apps.googleusercontent.com"
  },
  // Preview deployments of other branches and pull requests (`wrangler preview` in Cloudflare Builds).
  // No SHARES or DB here on purpose: a preview never touches the real shared cards or public gallery,
  // so sharing and the public gallery are switched off there; everything else works.
  "previews": {
    "vars": {
      "GOOGLE_WEB_CLIENT_ID": "210055593962-3ajro5cogq75030114aqmh737itftgcl.apps.googleusercontent.com"
    }
  }
}
