{
  // Cloudflare Workers static assets: everything in ./public is served as-is.
  // The Worker name must match the project name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holo-cards",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
